# Frontend Environment Variables Template
# Copy this file, rename it to .env or .env.local, and fill in your actual values.

# ── API Connection ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Use the same web-client ID as GOOGLE_CLIENT_ID in the backend environment.
# The browser origin must be registered in Google Cloud Console for this client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here"
