# Frontend Environment Variables Template
# Copy this file, rename it to .env or .env.local, and fill in your actual values.

# ── API Connection ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Public canonical origin, used by metadata, structured data and the sitemap.
# Set at build time; use your primary HTTPS domain, without a path.
NEXT_PUBLIC_SITE_URL="https://servicehubcordova.tech"
# Set false for non-public deployments. Vercel previews are always noindex.
SEO_INDEXING_ENABLED="true"

# Optional OpenMapTiles-compatible vector style. Labels prefer English, then Latin transliterations.
# Defaults to this public OpenFreeMap style; no API key is required.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Use the same web-client ID as GOOGLE_CLIENT_ID in the backend environment.
# The browser origin must be registered in Google Cloud Console for this client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here"
