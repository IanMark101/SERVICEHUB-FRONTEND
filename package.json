    "@phosphor-icons/react": "^2.1.10",
    "axios": "^1.18.0",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "leaflet": "1.9.4",
    "lenis": "1.3.26",
    "lucide-react": "^1.18.0",
    "maplibre-gl": "6.4.1",
    "motion": "^13.5.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "socket.io-client": "^4.8.3",
